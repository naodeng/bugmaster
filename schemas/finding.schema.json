{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugmaster.dev/schemas/finding.schema.json",
  "title": "BugMaster Finding metadata",
  "description": "A versioned local Finding record. A structurally valid record is not source-authenticated, human-reviewed, or eligible for confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "findingId",
    "revision",
    "status",
    "candidateRefs",
    "observedSurfaces",
    "patternId",
    "oracleRef",
    "businessContext",
    "actualBehavior",
    "expectedBehavior",
    "preconditions",
    "actionRefs",
    "evidenceRefs",
    "severity",
    "confidence",
    "attribution",
    "limitations",
    "remediation",
    "regressionRecommendation",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "findingId": {"type": "string", "pattern": "^FND-[A-Z0-9][A-Z0-9-]{0,63}(?![\\s\\S])"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["hypothesis", "observed", "suspected", "needs_review", "confirmed", "rejected", "duplicate", "resolved", "reopened"]
    },
    "candidateRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "revision"],
        "properties": {
          "candidateId": {"type": "string", "pattern": "^CF-[A-Z0-9][A-Z0-9-]{0,63}(?![\\s\\S])"},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "observedSurfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "patternId": {"type": "string", "pattern": "^BP-[A-Z]+-[0-9]{3}(?![\\s\\S])"},
    "oracleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracleId", "revision", "sha256"],
      "properties": {
        "oracleId": {"type": "string", "pattern": "^OR-[A-Z0-9][A-Z0-9-]{0,63}(?![\\s\\S])"},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
      }
    },
    "businessContext": {"type": "string", "minLength": 1},
    "actualBehavior": {"type": "string", "minLength": 1},
    "expectedBehavior": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "actionRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "journalId", "actionId", "sequence", "entryHash"],
        "properties": {
          "sessionId": {"type": "string", "minLength": 1},
          "journalId": {"type": "string", "minLength": 1},
          "actionId": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "entryHash": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "sha256", "byteLength"],
        "properties": {
          "evidenceId": {"type": "string", "pattern": "^EV-[A-Z0-9][A-Z0-9-]{0,63}(?![\\s\\S])"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
          "byteLength": {"type": "integer", "minimum": 0}
        }
      }
    },
    "severity": {"type": ["string", "null"], "minLength": 1},
    "confidence": {"type": ["string", "null"], "minLength": 1},
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "validationLevel"],
      "properties": {
        "layer": {"type": "string", "minLength": 1},
        "validationLevel": {"enum": ["E0", "E1", "E2", "E3", "E4", "unknown"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "remediation": {"type": "string", "minLength": 1},
    "regressionRecommendation": {"type": "string", "minLength": 1},
    "recordedAt": {"type": "string", "format": "date-time"}
  }
}
